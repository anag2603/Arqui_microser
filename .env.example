# ===== PostgreSQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
AUTH_DB=auth_db
USER_DB=user_db

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== JWT =====
# Cambiar por un valor largo y aleatorio en cualquier entorno real
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=604800

# ===== Seguridad y sesiones =====
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
SESSION_INACTIVITY_SECONDS=1800
PROFILE_CACHE_TTL_SECONDS=300

# ===== Puertos de los servicios =====
GATEWAY_PORT=3000
AUTH_PORT=3001
USER_PORT=3002
USER_SERVICE_PORT=3002

# ===== URLs entre servicios (desarrollo local) =====
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002

# ===== Front (origen permitido por CORS en el gateway) =====
FRONTEND_ORIGIN=http://localhost:5173

# ===== Mocks de desarrollo (cambiar a false cuando auth y redis estén mergeados) =====
USE_MOCKS=true
